{
  "component": "party",
  "baseUrl": "http://localhost:8080",
  "ui": "Swagger UI (/swagger-ui/index.html)。user は local プロファイルのデモユーザー名、パスワードは環境変数 PARTY_DEMO_PASSWORD（画面に映さない）。user が null の場合は認証なし。",
  "cases": [
    {"id": "PARTY-E2E-01", "name": "未認証アクセスは 401",
     "request": {"method": "GET", "path": "/api/party/entities/Party", "user": null},
     "expected": {"status": 401}},
    {"id": "PARTY-E2E-02", "name": "PARTYMGR 権限なしは 403",
     "request": {"method": "GET", "path": "/api/party/entities/Party", "user": "nopartymgr"},
     "expected": {"status": 403}},
    {"id": "PARTY-E2E-03", "name": "閲覧専用ユーザーの作成は 403",
     "request": {"method": "POST", "path": "/api/party/services/createPartyGroup", "user": "readonly",
                 "body": {"partyId": "E2E_DENIED", "groupName": "Denied"}},
     "expected": {"status": 403}},
    {"id": "PARTY-E2E-04", "name": "機密 Entity UserLogin: 閲覧専用ユーザーは 403",
     "request": {"method": "GET", "path": "/api/party/entities/UserLogin", "user": "readonly"},
     "expected": {"status": 403}},
    {"id": "PARTY-E2E-05", "name": "機密 Entity UserLogin: 専用権限ユーザーは 200 でパスワード伏せ字",
     "request": {"method": "GET", "path": "/api/party/entities/UserLogin", "user": "sensitive"},
     "expected": {"status": 200, "values": {"currentPassword (全行)": "[REDACTED] または null"}}},
    {"id": "PARTY-E2E-06", "name": "entity-auto 作成 createPartyClassificationType",
     "request": {"method": "POST", "path": "/api/party/services/createPartyClassificationType", "user": "admin",
                 "body": {"partyClassificationTypeId": "E2E_CLASS", "description": "E2E 分類"}},
     "expected": {"status": 200, "values": {"partyClassificationTypeId": "E2E_CLASS", "responseMessage": "success"}}},
    {"id": "PARTY-E2E-07", "name": "entity-auto 取得",
     "request": {"method": "GET", "path": "/api/party/entities/PartyClassificationType/one?partyClassificationTypeId=E2E_CLASS", "user": "admin"},
     "expected": {"status": 200, "values": {"description": "E2E 分類"}}},
    {"id": "PARTY-E2E-08", "name": "entity-auto 更新 updatePartyClassificationType と再取得",
     "request": {"method": "POST", "path": "/api/party/services/updatePartyClassificationType", "user": "admin",
                 "body": {"partyClassificationTypeId": "E2E_CLASS", "description": "E2E 分類（更新）"}},
     "expected": {"status": 200, "values": {"再取得 description": "E2E 分類（更新）"}}},
    {"id": "PARTY-E2E-09", "name": "entity-auto 削除 deletePartyClassificationType と再取得 404",
     "request": {"method": "POST", "path": "/api/party/services/deletePartyClassificationType", "user": "admin",
                 "body": {"partyClassificationTypeId": "E2E_CLASS"}},
     "expected": {"status": 200, "values": {"再取得 (GET .../PartyClassificationType/one?partyClassificationTypeId=E2E_CLASS)": 404}}},
    {"id": "PARTY-E2E-10", "name": "simple: createPersonAndUserLogin（パスワードはハッシュ保存・応答は伏せ字）",
     "request": {"method": "POST", "path": "/api/party/services/createPersonAndUserLogin", "user": "admin",
                 "body": {"partyId": "E2E_LOGIN", "firstName": "Hanako", "lastName": "Yamada", "userLoginId": "e2e-hanako",
                          "currentPassword": "e2e-pass-123", "currentPasswordVerify": "e2e-pass-123"}},
     "expected": {"status": 200, "values": {"partyId": "E2E_LOGIN", "currentPassword": "[REDACTED]"}}},
    {"id": "PARTY-E2E-11", "name": "simple: createPartyEmailAddress → findPartyFromEmailAddress",
     "request": {"method": "POST", "path": "/api/party/services/createPartyEmailAddress", "user": "admin",
                 "body": {"partyId": "E2E_LOGIN", "emailAddress": "hanako@example.test"},
                 "then": {"method": "POST", "path": "/api/party/services/findPartyFromEmailAddress", "body": {"address": "hanako@example.test"}}},
     "expected": {"status": 200, "values": {"contactMechId": "採番値", "検索結果": "partyId E2E_LOGIN を含む"}}},
    {"id": "PARTY-E2E-12", "name": "主要フロー: 組織作成 createPartyGroup",
     "request": {"method": "POST", "path": "/api/party/services/createPartyGroup", "user": "admin",
                 "body": {"groupName": "E2E 商事"}},
     "expected": {"status": 200, "values": {"partyId": "採番値（以下 {ORG}）"},
                  "verify": {"method": "GET", "path": "/api/party/entities/Party?partyId={ORG}",
                             "values": {"statusId": "PARTY_ENABLED"}}}},
    {"id": "PARTY-E2E-13", "name": "主要フロー: 人物作成 createPerson",
     "request": {"method": "POST", "path": "/api/party/services/createPerson", "user": "admin",
                 "body": {"firstName": "Taro", "lastName": "Suzuki"}},
     "expected": {"status": 200, "values": {"partyId": "採番値（以下 {PERSON}）"},
                  "verify": {"method": "GET", "path": "/api/party/entities/Party?partyId={PERSON}",
                             "values": {"statusId": "PARTY_ENABLED"}}}},
    {"id": "PARTY-E2E-14", "name": "主要フロー: 役割 createPartyRole（組織 INTERNAL_ORGANIZATIO、人物 EMPLOYEE）",
     "request": {"method": "POST", "path": "/api/party/services/createPartyRole", "user": "admin",
                 "body": [{"partyId": "{ORG}", "roleTypeId": "INTERNAL_ORGANIZATIO"}, {"partyId": "{PERSON}", "roleTypeId": "EMPLOYEE"}]},
     "expected": {"status": 200, "values": {"2 回とも": "200"}}},
    {"id": "PARTY-E2E-15", "name": "主要フロー: 関係 createPartyRelationship（EMPLOYMENT と CONTACT_REL）",
     "request": {"method": "POST", "path": "/api/party/services/createPartyRelationship", "user": "admin",
                 "body": [{"partyIdFrom": "{ORG}", "partyIdTo": "{PERSON}", "roleTypeIdFrom": "INTERNAL_ORGANIZATIO", "roleTypeIdTo": "EMPLOYEE", "partyRelationshipTypeId": "EMPLOYMENT"},
                          {"partyIdFrom": "{ORG}", "partyIdTo": "{PERSON}", "partyRelationshipTypeId": "CONTACT_REL"}]},
     "expected": {"status": 200, "values": {"2 回とも": "200", "2 件目の roleTypeIdFrom/To": "_NA_"}}},
    {"id": "PARTY-E2E-16", "name": "主要フロー: 連絡先 住所・電話・メール作成",
     "request": {"method": "POST", "path": "/api/party/services/createPartyPostalAddress | createPartyTelecomNumber | createPartyEmailAddress", "user": "admin",
                 "body": [{"partyId": "{PERSON}", "address1": "1-2-3 Marunouchi", "city": "Chiyoda", "postalCode": "100-0005"},
                          {"partyId": "{PERSON}", "areaCode": "03", "contactNumber": "12345678"},
                          {"partyId": "{PERSON}", "emailAddress": "taro@example.test"}]},
     "expected": {"status": 200, "values": {"各 contactMechId": "採番値"}}},
    {"id": "PARTY-E2E-17", "name": "主要フロー: 取得 getPartyPostalAddress / getPartyTelephone / getPartyEmail",
     "request": {"method": "POST", "path": "/api/party/services/getPartyPostalAddress | getPartyTelephone | getPartyEmail", "user": "admin",
                 "body": {"partyId": "{PERSON}"}},
     "expected": {"status": 200, "values": {"address1": "1-2-3 Marunouchi", "contactNumber": "12345678", "infoString": "taro@example.test"}}},
    {"id": "PARTY-E2E-18", "name": "主要フロー: 関係種別での削除 deletePartyRelationship(CONTACT_REL) 後、EMPLOYMENT のみ残る",
     "request": {"method": "POST", "path": "/api/party/services/deletePartyRelationship", "user": "admin",
                 "body": {"partyIdFrom": "{ORG}", "partyIdTo": "{PERSON}", "partyRelationshipTypeId": "CONTACT_REL", "fromDate": "E2E-15 2 件目（CONTACT_REL）応答の fromDate をそのまま使う"},
                 "then": {"method": "GET", "path": "/api/party/entities/PartyRelationship?partyIdFrom={ORG}&partyIdTo={PERSON}"}},
     "expected": {"status": 200, "values": {"残件数": 1, "partyRelationshipTypeId": "EMPLOYMENT"}}},
    {"id": "PARTY-E2E-19", "name": "multi: 2 件目が重複なら 409 で全件ロールバック",
     "request": {"method": "POST", "path": "/api/party/services/createPartyRole/multi", "user": "admin",
                 "body": [{"partyId": "{ORG}", "roleTypeId": "CUSTOMER"}, {"partyId": "{ORG}", "roleTypeId": "CUSTOMER"}],
                 "then": {"method": "GET", "path": "/api/party/entities/PartyRole?partyId={ORG}&roleTypeId=CUSTOMER"}},
     "expected": {"status": 409, "values": {"errors[0].errorMessage": "ServiceValueFound", "再取得": "[]（1 件目もロールバック）"}}}
  ]
}
