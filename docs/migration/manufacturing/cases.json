  {
    "id": "MANUFACTURING-E2E-04",
    "name": "カレンダー CRUD",
    "steps": [
      {
        "id": "MANUFACTURING-E2E-04-01",
        "request": {
          "method": "POST",
          "path": "/api/manufacturing/services/createCalendar",
          "user": "mfgwriter",
          "body": {
            "calendarId": "E2E_CAL",
            "description": "E2E"
          }
        },
        "expected": {
          "status": 200,
          "calendarId": "E2E_CAL"
        }
      },
      {
        "id": "MANUFACTURING-E2E-04-02",
        "request": {
          "method": "GET",
          "path": "/api/manufacturing/entities/TechDataCalendar/one?calendarId=E2E_CAL",
          "user": "mfgwriter",
          "body": null
        },
        "expected": {
          "status": 200,
          "description": "E2E"
        }
      },
      {
        "id": "MANUFACTURING-E2E-04-03",
        "request": {
          "method": "POST",
          "path": "/api/manufacturing/services/updateCalendar",
          "user": "mfgwriter",
          "body": {
            "calendarId": "E2E_CAL",
            "description": "updated"
          }
        },
        "expected": {
          "status": 200
        }
      },
      {
        "id": "MANUFACTURING-E2E-04-04",
        "request": {
          "method": "GET",
          "path": "/api/manufacturing/entities/TechDataCalendar/one?calendarId=E2E_CAL",
          "user": "mfgwriter",
          "body": null
        },
        "expected": {
          "status": 200,
          "description": "updated"
        }
      },
      {
        "id": "MANUFACTURING-E2E-04-05",
        "request": {
          "method": "POST",
          "path": "/api/manufacturing/services/createCalendarExceptionDay",
          "user": "mfgwriter",
          "body": {
            "calendarId": "E2E_CAL",
            "exceptionDateStartTime": "2025-01-01T00:00:00Z",
            "description": "holiday"
          }
        },
        "expected": {
          "status": 200
        }
      },
      {
        "id": "MANUFACTURING-E2E-04-06",
        "request": {
          "method": "POST",
          "path": "/api/manufacturing/services/removeCalendarExceptionDay",
