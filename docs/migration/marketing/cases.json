{
  "component": "marketing",
  "baseUrl": "http://localhost:8080",
  "profile": "local",
  "notes": "パスワードは全ユーザー共通で環境変数 MIGRATION_DEMO_PASSWORD から渡す（画面に映さない）。{xxx} は前のケースの応答値で置き換える。",
  "cases": [
    {"id": "MARKETING-E2E-01", "name": "未認証は 401", "section": "権限",
     "request": {"method": "GET", "path": "/api/marketing/entities/MarketingCampaign", "user": null, "body": null},
     "expected": {"status": 401}},
    {"id": "MARKETING-E2E-02", "name": "MARKETING 権限なしユーザーは 403", "section": "権限",
     "request": {"method": "GET", "path": "/api/marketing/entities/MarketingCampaign", "user": "nomarketing", "body": null},
     "expected": {"status": 403}},
    {"id": "MARKETING-E2E-03", "name": "閲覧専用ユーザーの作成は 403", "section": "権限",
     "request": {"method": "POST", "path": "/api/marketing/services/createMarketingCampaign", "user": "readonly",
                 "body": {"campaignName": "E2E 権限確認"}},
     "expected": {"status": 403}},
    {"id": "MARKETING-E2E-04", "name": "機密 Entity（ContactListPartyStatus）は閲覧専用ユーザーで 403", "section": "機密",
     "request": {"method": "GET", "path": "/api/marketing/entities/ContactListPartyStatus", "user": "readonly", "body": null},
     "expected": {"status": 403}},
    {"id": "MARKETING-E2E-05", "name": "機密 Entity は MARKETING_SENSITIVE_VIEW を持つユーザーで 200", "section": "機密",
     "request": {"method": "GET", "path": "/api/marketing/entities/ContactListPartyStatus", "user": "sensitive", "body": null},
     "expected": {"status": 200, "body": "JSON 配列"}},
    {"id": "MARKETING-E2E-06", "name": "entity-auto 作成 createMarketingCampaign", "section": "entity-auto",
     "request": {"method": "POST", "path": "/api/marketing/services/createMarketingCampaign", "user": "marketer",
                 "body": {"campaignName": "E2E 秋キャンペーン", "isActive": "Y"}},
     "expected": {"status": 200, "responseMessage": "success", "marketingCampaignId": "採番された ID（{campaignId}）"}},
    {"id": "MARKETING-E2E-07", "name": "entity-auto 取得 MarketingCampaign", "section": "entity-auto",
     "request": {"method": "GET", "path": "/api/marketing/entities/MarketingCampaign/one?marketingCampaignId={campaignId}", "user": "readonly", "body": null},
     "expected": {"status": 200, "campaignName": "E2E 秋キャンペーン"}},
    {"id": "MARKETING-E2E-08", "name": "entity-auto 更新 updateMarketingCampaign", "section": "entity-auto",
     "request": {"method": "POST", "path": "/api/marketing/services/updateMarketingCampaign", "user": "marketer",
                 "body": {"marketingCampaignId": "{campaignId}", "campaignName": "E2E 冬キャンペーン"}},
     "expected": {"status": 200, "afterGet.campaignName": "E2E 冬キャンペーン"}},
    {"id": "MARKETING-E2E-09", "name": "entity-auto 削除 deleteMarketingCampaign", "section": "entity-auto",
     "request": {"method": "POST", "path": "/api/marketing/services/deleteMarketingCampaign", "user": "marketer",
                 "body": {"marketingCampaignId": "{campaignId}"}},
     "expected": {"status": 200, "afterGet": "GET /api/marketing/entities/MarketingCampaign?marketingCampaignId={campaignId} が []"}},
    {"id": "MARKETING-E2E-10", "name": "simple サービス createWebSiteContactList", "section": "simple",
     "request": {"method": "POST", "path": "/api/marketing/services/createWebSiteContactList", "user": "marketer",
                 "body": {"webSiteId": "E2E_WS", "contactListId": "E2E_CL_WS"}},
     "expected": {"status": 200, "fromDate": "自動設定された日時"}},
    {"id": "MARKETING-E2E-11", "name": "simple サービス arePartiesRelatedThroughSegmentGroup", "section": "simple",
     "request": {"method": "POST", "path": "/api/marketing/services/arePartiesRelatedThroughSegmentGroup", "user": "readonly",
                 "body": {"partyId": "E2E_P1", "toPartyId": "E2E_P2"}},
     "expected": {"status": 200, "areRelated": "N"}},
    {"id": "MARKETING-E2E-12", "name": "主要フロー1 キャンペーン作成", "section": "主要フロー",
     "request": {"method": "POST", "path": "/api/marketing/services/createMarketingCampaign", "user": "marketer",
                 "body": {"campaignName": "E2E ニュースレター施策"}},
     "expected": {"status": 200, "marketingCampaignId": "採番された ID（{flowCampaignId}）"}},
    {"id": "MARKETING-E2E-13", "name": "主要フロー2 連絡先リスト作成 createContactList", "section": "主要フロー",
     "request": {"method": "POST", "path": "/api/marketing/services/createContactList", "user": "marketer",
                 "body": {"contactListId": "E2E_CL", "contactListName": "E2E ニュースレター", "contactMechTypeId": "EMAIL_ADDRESS",
                          "marketingCampaignId": "{flowCampaignId}", "verifyEmailFrom": "noreply@example.com",
                          "verifyEmailScreen": "component://marketing/widget/EmailScreens.xml#ContactListVerify",
                          "verifyEmailSubject": "購読確認", "verifyEmailWebSiteId": "E2E_WS"}},
     "expected": {"status": 200, "contactListId": "E2E_CL"}},
    {"id": "MARKETING-E2E-14", "name": "主要フロー3 購読申込 signUpForContactList", "section": "主要フロー",
     "request": {"method": "POST", "path": "/api/marketing/services/signUpForContactList", "user": "marketer",
                 "body": {"contactListId": "E2E_CL", "email": "subscriber@example.com"}},
     "expected": {"status": 200, "statusId": "CLPT_PENDING", "partyId": "_NA_", "fromDate": "{fromDate}"}},
    {"id": "MARKETING-E2E-15", "name": "主要フロー4 確認コード取得（機密 Entity）", "section": "主要フロー",
     "request": {"method": "GET", "path": "/api/marketing/entities/ContactListPartyStatus?contactListId=E2E_CL", "user": "sensitive", "body": null},
     "expected": {"status": 200, "statusId": "CLPT_PENDING", "optInVerifyCode": "{code}（値は画面上で確認のみ）"}},
    {"id": "MARKETING-E2E-16", "name": "主要フロー5 購読確定 updateContactListPartyNoUserLogin", "section": "主要フロー",
     "request": {"method": "POST", "path": "/api/marketing/services/updateContactListPartyNoUserLogin", "user": "marketer",
                 "body": {"contactListId": "E2E_CL", "partyId": "_NA_", "fromDate": "{fromDate}", "statusId": "CLPT_ACCEPTED", "optInVerifyCode": "{code}"}},
     "expected": {"status": 200, "statusId": "CLPT_ACCEPTED"}},
    {"id": "MARKETING-E2E-17", "name": "主要フロー6 解除申請 unsubscribeContactListParty", "section": "主要フロー",
     "request": {"method": "POST", "path": "/api/marketing/services/unsubscribeContactListParty", "user": "marketer",
                 "body": {"contactListId": "E2E_CL", "email": "subscriber@example.com"}},
     "expected": {"status": 200, "statusId": "CLPT_UNSUBS_PENDING"}},
    {"id": "MARKETING-E2E-18", "name": "主要フロー7 解除確定 updateContactListParty", "section": "主要フロー",
     "request": {"method": "POST", "path": "/api/marketing/services/updateContactListParty", "user": "marketer",
                 "body": {"contactListId": "E2E_CL", "partyId": "_NA_", "fromDate": "{fromDate}", "statusId": "CLPT_UNSUBSCRIBED"}},
     "expected": {"status": 200, "statusId": "CLPT_UNSUBSCRIBED", "history": "ContactListPartyStatus が PENDING→ACCEPTED→UNSUBS_PENDING→UNSUBSCRIBED の4件"}},
    {"id": "MARKETING-E2E-19", "name": "multi で1件重複すると 409", "section": "multi",
     "request": {"method": "POST", "path": "/api/marketing/services/createContactListType/multi", "user": "marketer",
                 "body": [{"contactListTypeId": "E2E_MULTI_A", "description": "A"}, {"contactListTypeId": "E2E_MULTI_B", "description": "B"}, {"contactListTypeId": "E2E_MULTI_A", "description": "重複"}]},
     "expected": {"status": 409, "rolledBack": true, "errors[0].index": 2}},
    {"id": "MARKETING-E2E-20", "name": "multi 失敗後に全件ロールバックされている", "section": "multi",
     "request": {"method": "GET", "path": "/api/marketing/entities/ContactListType?contactListTypeId=E2E_MULTI_A", "user": "readonly", "body": null},
     "expected": {"status": 200, "body": "[]（E2E_MULTI_B も同様に []）"}}
  ]
}
