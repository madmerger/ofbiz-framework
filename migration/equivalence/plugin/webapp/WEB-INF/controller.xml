<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns="http://ofbiz.apache.org/Site-Conf" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf https://ofbiz.apache.org/dtds/site-conf.xsd">
    <handler name="groovy" type="request" class="org.apache.ofbiz.webapp.event.GroovyEventHandler"/>
    <request-map uri="dispatch">
        <security https="true" auth="false"/>
        <event type="groovy" path="component://equivalence/groovy/Dispatch.groovy"/>
        <response name="success" type="none"/>
        <response name="error" type="none"/>
    </request-map>
</site-conf>
